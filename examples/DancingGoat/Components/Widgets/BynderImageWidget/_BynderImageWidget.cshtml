@using DancingGoat.Widgets

@model BynderImageWidgetProperties

<div class="clear center-text">
	@if (Model.BynderImage != null)
	{
		@foreach (var item in Model.BynderImage)
		{
			<img src="@item.Files?.WebImage?.Url" alt="@item.Name" longdesc="@item.Description" width="@item.Files?.WebImage.Width" height="@item.Files?.WebImage.Height" />
		}
	}
</div>