<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Kentico.Xperience.Admin" Version="31.2.3" />
    <PackageVersion Include="Kentico.Xperience.Core" Version="31.2.3" />
    <PackageVersion Include="Kentico.Xperience.WebApp" Version="31.2.3" />
    <PackageVersion Include="kentico.xperience.azurestorage" Version="31.2.3" />
    <PackageVersion Include="kentico.xperience.imageprocessing" Version="31.2.3" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.8.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.21.0.135717" />
    <PackageVersion Include="XperienceCommunity.Bynder" Version="1.2.0" />
  </ItemGroup>
</Project>